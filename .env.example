# คัดลอกเป็น .env แล้วแก้ค่าก่อนรันจริง
# cp .env.example .env

# ลับเซ็น JWT — สร้างแบบสุ่ม: openssl rand -hex 32
JWT_SECRET=change-me-to-random-64-hex-chars

# ลับตรวจ webhook (mock) — ตอนสลับ Omise จะใช้ Omise webhook secret แทน
MOCK_WEBHOOK_SECRET=mock-secret-change-me

# Phase 6: Omise — ใส่ secret key เพื่อเปิดใช้เงินจริง (เว้นว่าง = ใช้ Mock)
# skey_test_... = test mode (ไม่ตัดเงินจริง), skey_live_... = production
# ใช้ได้ทั้ง secret key (skey_*) สำหรับ API หลังบ้าน
OMISE_SECRET_KEY=

# ฐานข้อมูล (SQLite ช่วง mock; Phase 6 ค่อยเปลี่ยนเป็น Postgres)
DATABASE_URL=sqlite://donations.db?mode=rwc

# สตรีมเมอร์ default ช่วง Phase 1
DEFAULT_USER_ID=default
